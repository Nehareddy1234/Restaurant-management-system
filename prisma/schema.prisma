generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Table {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int
  status   String
  orders   Order[]
}

model Order {
  id            String      @id @default(uuid())
  tableId       Int?
  total         Int
  status        String
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  customerId    String?
  orderNumber   Int
  paymentMethod String      @default("Cash")
  orderDate     String
  customerName  String?
  paymentStatus String      @default("Paid")
  customer      Profile?    @relation(fields: [customerId], references: [id])
  table         Table?      @relation(fields: [tableId], references: [id])
  items         OrderItem[]

  @@unique([orderDate, orderNumber])
}

model OrderDailySequence {
  date       String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    String
  menuItemId Int
  quantity   Int
  addOns     Json?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model MenuItem {
  id       Int         @id @default(autoincrement())
  name     String
  category String
  price    Int
  enabled  Boolean     @default(true)
  image    String?
  orders   OrderItem[]
}

model GroceryItem {
  id        Int     @id @default(autoincrement())
  name      String
  quantity  Float
  unit      String
  purchased Boolean @default(false)
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  category    String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
}

model StoreProduct {
  id       String  @id
  name     String
  category String
  price    Int
  stock    Int
  image    String?
}

model Profile {
  id             String    @id @default(uuid())
  username       String    @unique
  role           String
  address        String?
  avatar         String?
  createdAt      DateTime  @default(now())
  displayName    String?
  password       String?
  phone          String?
  approvalStatus String    @default("approved")
  approvedAt     DateTime?
  approvedBy     String?
  orders         Order[]
}

model MenuCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
}

