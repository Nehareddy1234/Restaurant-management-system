generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Table {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int
  status   String
  orders   Order[]
}

model Order {
  id            String      @id @default(uuid())
  tableId       Int?
  total         Int
  status        String
  createdAt     DateTime    @default(now())
  paidAt        DateTime?
  customerId    String?
  orderNumber   Int
  paymentMethod String      @default("Cash")
  orderDate     String
  customerName  String?
  paymentStatus String      @default("Paid")
  customer      Profile?    @relation(fields: [customerId], references: [id])
  table         Table?      @relation(fields: [tableId], references: [id])
  items         OrderItem[]

  @@unique([orderDate, orderNumber])
}

model OrderDailySequence {
  date       String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    String
  menuItemId Int
  quantity   Int
  addOns     Json?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model MenuItem {
  id              Int         @id @default(autoincrement())
  name            String
  category        String
  price           Int
  enabled         Boolean     @default(true)
  availableOnline Boolean     @default(true)
  image           String?
  orderIndex      Int         @default(0)
  orders          OrderItem[]
}

model GroceryItem {
  id        Int     @id @default(autoincrement())
  name      String
  quantity  Float
  unit      String
  purchased Boolean @default(false)
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String
  category    String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
}

model StoreProduct {
  id                String  @id
  name              String
  category          String
  price             Int
  buyingCost        Int?    @default(0)
  stock             Int
  lowStockThreshold Int                 @default(10)
  image             String?
  supplierItems     SupplierOrderItem[]
  storeOrderItems   StoreOrderItem[]
}

model SupplierOrder {
  id            String              @id @default(uuid())
  supplierName  String
  status        String              @default("Ordered") // Ordered, Received
  totalAmount   Int
  paymentStatus String              @default("Unpaid") // Unpaid, Paid
  orderDate     DateTime            @default(now())
  receiveDate   DateTime?
  paymentDate   DateTime?
  items         SupplierOrderItem[]
}

model SupplierOrderItem {
  id              Int           @id @default(autoincrement())
  supplierOrderId String
  productId       String
  quantity        Int
  buyingCost      Int
  product         StoreProduct  @relation(fields: [productId], references: [id])
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
}

model StoreOrder {
  id            String            @id @default(uuid())
  orderNumber   String
  totalAmount   Int
  paymentMethod String            @default("Cash")
  orderDate     DateTime          @default(now())
  items         StoreOrderItem[]
}

model StoreOrderItem {
  id            Int          @id @default(autoincrement())
  storeOrderId  String
  productId     String
  quantity      Int
  price         Int
  buyingCost    Int          @default(0)
  product       StoreProduct @relation(fields: [productId], references: [id])
  storeOrder    StoreOrder   @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
}

model Profile {
  id             String    @id @default(uuid())
  username       String    @unique
  role           String
  address        String?
  avatar         String?
  createdAt      DateTime  @default(now())
  displayName    String?
  password       String?
  phone          String?
  approvalStatus String    @default("approved")
  approvedAt     DateTime?
  approvedBy     String?
  orders         Order[]
}

model MenuCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
}

